<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Dashboard.Wasm</RootNamespace>

    <!--
      Payload trimming. This bundle is downloaded by anyone who opens the
      demo, so what ships matters.

      InvariantGlobalization drops ~2.6 MB of ICU locale data that nothing
      here uses: the only culture-sensitive operations are DateOnly and
      decimal parsing of ISO/invariant strings coming from JSON, and every
      piece of user-facing number and date formatting happens in JavaScript
      via Intl, not in .NET.

      UseSystemResourceKeys is deliberately NOT set. It would strip another
      ~200 KB by replacing framework exception messages with opaque codes,
      but DemoApi returns exception messages to the user, so the saving would
      be paid for in unreadable errors.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>

    <!--
      The one project opted out of the solution-wide lock files.

      Targeting browser-wasm pulls in SDK-derived packages, notably
      Microsoft.NET.ILLink.Tasks, whose version tracks the installed .NET
      runtime patch rather than anything chosen here. Locking it means the
      lock file records the patch level of whichever machine last ran restore,
      and CI then fails with NU1004 the moment its runner image differs by a
      patch. That is a false alarm about a package nobody selected.

      The nine projects holding actual third-party dependencies (EF Core,
      Npgsql, xUnit) keep locked restore, which is where the value is. This
      one trades it away rather than lowering the gate for everything.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dashboard.Demo brings Dashboard.Application and Dashboard.Domain with it.
         This project references nothing else: it is a thin interop façade,
         and any logic that appeared here would be logic the real API does
         not run. -->
    <ProjectReference Include="..\Dashboard.Demo\Dashboard.Demo.csproj" />
  </ItemGroup>

</Project>
