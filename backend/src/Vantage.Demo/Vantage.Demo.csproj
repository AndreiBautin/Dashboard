<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vantage.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vantage.Application\Vantage.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The in-memory store keeps its write surface internal: nothing outside
      this assembly should be able to push rows into it directly. The tests
      need to reach in precisely to prove that seeding cannot overwrite data
      that is already there, which is what this is for.
    -->
    <InternalsVisibleTo Include="Vantage.Demo.Tests" />
  </ItemGroup>

</Project>
